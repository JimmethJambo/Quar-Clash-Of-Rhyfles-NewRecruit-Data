      <rules>
        <rule name="Veteran" id="68ac-e40a-ad0e-ad41" hidden="false">
          <description>Trained to shrug off battlefield conditions that leave other rhyflers subdued, a successful recovery does not count as one of a Veteran rhyfler’s two allowed activations. Mounted Fyrshog may use this to clear Rattled without counting as one of their two activations</description>
        </rule>
